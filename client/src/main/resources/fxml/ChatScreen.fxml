<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="de.uol.swp.client.chat.detail.ChatDetailPresenter"
            prefHeight="400.0" prefWidth="600.0">
    <VBox spacing="10.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
        <children>
            <!-- Chat-Nachrichtenanzeige -->
            <TextArea fx:id="chatArea" editable="false" prefHeight="200.0" wrapText="true" />

            <!-- Eingabebereich für Chat -->
            <HBox spacing="10.0">
                <TextField fx:id="chatInput" promptText="Nachricht eingeben..." HBox.hgrow="ALWAYS" />
                <Button fx:id="sendChatButton" mnemonicParsing="false" text="Senden" onAction="#onSendChat" />
            </HBox>
        </children>
    </VBox>
</AnchorPane>
