<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.uol.swp.client.chat.detail.ChatDetailPresenter">
      <!-- Chat-Nachrichtenanzeige -->
      <TextArea fx:id="chatArea" editable="false" prefHeight="200.0" wrapText="true" AnchorPane.bottomAnchor="50.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0" />

      <!-- Eingabebereich für Chat -->
      <HBox spacing="10.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0">
          <TextField fx:id="chatInput" promptText="Nachricht eingeben..." HBox.hgrow="ALWAYS" />
          <Button fx:id="sendChatButton" mnemonicParsing="false" onAction="#onSendChat" text="Senden" />
      </HBox>
</AnchorPane>
