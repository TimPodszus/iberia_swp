<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="de.uol.swp.client.chat.detail.ChatDetailPresenter"
            prefHeight="400.0" prefWidth="600.0">

    <!-- Button zum Ein- und Ausklappen des Chats -->
    <Button fx:id="toggleChatButton"
            text="Chat"
            layoutX="10"
            layoutY="50"
            onAction="#toggleChatVisibility"
            prefWidth="60" />

    <!-- Chat-Container, der ein- und ausgeklappt wird -->
    <VBox fx:id="chatContainer"
          spacing="10.0"
          visible="false"
          managed="false"
          layoutX="10"
          layoutY="80"
          prefWidth="300"
          prefHeight="400"
          style="-fx-background-color: rgba(0, 0, 0, 0.7); -fx-padding: 10; -fx-border-radius: 10; -fx-background-radius: 10;">

        <children>
            <!-- Chat-Nachrichtenanzeige -->
            <TextArea fx:id="chatArea" editable="false" prefHeight="200.0" wrapText="true" />

            <!-- Eingabebereich für Chat -->
            <HBox spacing="10.0">
                <TextField fx:id="chatInput" promptText="Nachricht eingeben..." HBox.hgrow="ALWAYS" />
                <Button fx:id="sendChatButton" mnemonicParsing="false" text="Senden" onAction="#onSendChat" />
            </HBox>
        </children>
    </VBox>

</AnchorPane>
