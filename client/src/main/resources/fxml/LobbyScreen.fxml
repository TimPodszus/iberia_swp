<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="436.0" prefWidth="722.0" styleClass="background-pane" stylesheets="@../css/optionView.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.uol.swp.client.lobby.detail.LobbyDetailPresenter">
   <children>
      <AnchorPane layoutX="261.0" layoutY="118.0" prefHeight="200.0" prefWidth="200.0" styleClass="content-pane" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="80.0" AnchorPane.rightAnchor="80.0" AnchorPane.topAnchor="20.0">
         <children>
            <Label fx:id="lobbyName" layoutX="161.0" layoutY="70.0" styleClass="h2" text="Lobby" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
            <VBox prefHeight="200.0" prefWidth="100.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="40.0">
               <children>
                  <HBox prefHeight="100.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
                     <children>
                        <VBox prefHeight="200.0" prefWidth="514.0" spacing="18.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label fx:id="playerCount" text="Anzahl Spieler : &lt;spieler&gt;/5" />
                              <VBox maxHeight="-Infinity" prefWidth="100.0" spacing="6.0" VBox.vgrow="NEVER">
                                 <children>
                                    <Label text="Schwierigkeit" />
                                    <ChoiceBox fx:id="difficultyDropdown" prefWidth="150.0" />
                                 </children>
                              </VBox>
                              <VBox prefHeight="160.0" prefWidth="514.0">
                                 <children>
                                    <Label text="Lobbypasswort" />
                                    <TextField fx:id="lobbyPasswordField" maxWidth="150.0" prefWidth="150.0" />
                                 </children>
                              </VBox>
                           </children>
                        </VBox>
                        <TableView fx:id="userTable" prefHeight="200.0" prefWidth="200.0">
                          <columns>
                            <TableColumn prefWidth="99.0" text="Spieler" />
                          </columns>
                        </TableView>
                     </children>
                  </HBox>
                  <HBox prefHeight="23.0" prefWidth="514.0">
                     <children>
                        <Button fx:id="startGameButton" mnemonicParsing="false" onAction="#onGameStart" text="Spiel starten">
                           <HBox.margin>
                              <Insets bottom="10.0" right="10.0" top="10.0" />
                           </HBox.margin>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#onLobbyLeave" text="Lobby verlassen">
                           <HBox.margin>
                              <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                           </HBox.margin>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#onLobbyClose" text="Lobby schließen">
                           <HBox.margin>
                              <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                           </HBox.margin>
                        </Button>
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
