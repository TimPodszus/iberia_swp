<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" styleClass="dialog-pane" stylesheets="@../css/myDialog.css"
            xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.uol.swp.client.main.MainMenuPresenter">
    <VBox alignment="CENTER" layoutX="250.0" layoutY="100.0" prefHeight="200.0" prefWidth="100.0" spacing="12.0"
          AnchorPane.bottomAnchor="100.0" AnchorPane.leftAnchor="240.0" AnchorPane.rightAnchor="240.0"
          AnchorPane.topAnchor="100.0">
        <children>
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onCurrentGamesButtonPressed"
                    style="-fx-margin: 12px;" styleClass="menu-button" text="Current games"/>
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onJoinLobbyButtonPressed"
                   styleClass="menu-button" stylesheets="@../css/myDialog.css" text="Join lobby" />
         <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onCreateLobbyButtonPressed"
                 styleClass="menu-button" stylesheets="@../css/myDialog.css" text="Create lobby" />
         <HBox alignment="CENTER" prefWidth="200.0" spacing="12.0">
            <children>
               <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onOptionsButtonPressed"
                            styleClass="menu-button" stylesheets="@../css/myDialog.css" text="Options"
                            HBox.hgrow="ALWAYS"/>
                    <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onRulesButtonPressed"
                            styleClass="menu-button" stylesheets="@../css/myDialog.css" text="Rules"
                            HBox.hgrow="ALWAYS"/>
                </children>
            </HBox>
        </children>
    </VBox>
    <Label alignment="CENTER" layoutX="241.0" layoutY="45.0" styleClass="title" text="IBERIA" textAlignment="CENTER"
           AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="45.0">
        <font>
            <Font size="36.0"/>
        </font>
    </Label>
</AnchorPane>
